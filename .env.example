# ── Credentials (required) ─────────────────────────────────────────────
API_ID=
API_HASH=
BOT_TOKEN=

# ── Database (required) ────────────────────────────────────────────────
DB_URI=
DB_NAME=Cluster0

# ── Channels & admins ──────────────────────────────────────────────────
# Channel that receives the bot's log messages.
LOG_CHANNEL=-1001234567890
# Channel the bot verifies at startup (must be accessible by the bot).
CHANNEL_ID=-1001234567890
# Channel where uploaded files are stored; deep links are derived from it.
FILE_STORE=-1001234567890
# Space-separated Telegram user ids with admin access.
ADMINS=123456789

# ── Branding / force-subscribe ─────────────────────────────────────────
BRAND_UNAME=@Nova_Networks
BAN_SUPPORT=https://t.me/AnimeNovaChat
MHCHANNEL_URL=https://t.me/+FiSlYftjwnAzMzVl
FSUB_LINK_EXPIRY=120

# ── Content protection ─────────────────────────────────────────────────
PROTECT_CONTENT=False
DISABLE_CHANNEL_BUTTON=False

# ── Encode profiles (one ffmpeg command per quality) ───────────────────
# {} placeholders are, in order: input, progress file, output.
FFCODE_HDRip=ffmpeg -i '{}' -progress '{}' -map 0 -c copy '{}' -y
FFCODE_1080=ffmpeg -i '{}' -progress '{}' -map 0:V -map 0:a? -map 0:s? -c:v libx264 -preset veryfast -crf 24 -pix_fmt yuv420p -s 1920x1080 -movflags +faststart -c:a aac -b:a 96k -c:s copy '{}' -y
FFCODE_720=ffmpeg -i '{}' -progress '{}' -map 0:V -map 0:a? -map 0:s? -c:v libx264 -preset veryfast -crf 28 -pix_fmt yuv420p -s 1280x720 -movflags +faststart -c:a aac -b:a 80k -c:s copy '{}' -y
FFCODE_480=ffmpeg -i '{}' -progress '{}' -map 0:V -map 0:a? -map 0:s? -c:v libx264 -preset veryfast -crf 32 -pix_fmt yuv420p -s 840x480 -movflags +faststart -c:a aac -b:a 64k -c:s copy '{}' -y
FFCODE_360=ffmpeg -i '{}' -progress '{}' -map 0:V -map 0:a? -map 0:s? -c:v libx264 -preset veryfast -crf 34 -pix_fmt yuv420p -s 640x360 -movflags +faststart -c:a aac -b:a 48k -c:s copy '{}' -y
QUALS=480 720 1080 HDRip

# ── Upload ─────────────────────────────────────────────────────────────
# Files larger than this (MiB) are split into playable parts before upload.
MAX_UPLOAD_SIZE=1900
# Send files as documents instead of streaming video.
AS_DOC=True

# ── Artwork ────────────────────────────────────────────────────────────
THUMB=
START_PIC=https://i.ibb.co/7NLDxTWF/x.jpg
FORCE_PIC=https://i.ibb.co/7NLDxTWF/x.jpg
# 16:9 image used on every channel post (the post header).
POST_PIC=https://i.ibb.co/7NLDxTWF/x.jpg

# ── Finder / leecher pipeline ──────────────────────────────────────────
# Channel where finished posts (with download buttons) are published.
POST_CHANNEL=-1001234567890
# Comma separated torrent providers to search.
# Built-in ids: nyaa, subsplease, apibay, eztv, yts, torrentgalaxy, animetosho
TORRENT_SITES=nyaa,subsplease,apibay,eztv,yts,torrentgalaxy
CUSTOM_SITES_FILE=custom_sites.json
RESULTS_PER_PAGE=10
MAX_RESULTS=60

# ── Metadata ───────────────────────────────────────────────────────────
# auto (AniList/TMDB) | custom (bot's Metadata editor) | off
METADATA_MODE=auto
# TMDB key, optional (used for movie / series metadata).
TMDB_API_KEY=

# ── Feature defaults (also toggled live from the bot's settings menu) ──
AUTO_POST=True

# ── Templates (optional; leave blank for the built-in defaults) ────────
CAPTION_TEMPLATE=
FILENAME_TEMPLATE=

# ── Self-update (leave off) ────────────────────────────────────────────
# Only pulls UPSTREAM_REPO when AUTO_UPDATE=true. Keep false so a deploy
# can never overwrite your code.
AUTO_UPDATE=false
