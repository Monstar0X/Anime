FFCODE_720=ffmpeg -i '{}' -progress '{}' -map 0:V -map 0:a? -map 0:s? -c:v libx264 -preset veryfast -crf 28 -pix_fmt yuv420p -s 1280x720 -movflags +faststart -c:a aac -b:a 80k -c:s copy '{}' -y
FFCODE_480=ffmpeg -i '{}' -progress '{}' -map 0:V -map 0:a? -map 0:s? -c:v libx264 -preset veryfast -crf 32 -pix_fmt yuv420p -s 840x480 -movflags +faststart -c:a aac -b:a 64k -c:s copy '{}' -y
FFCODE_360=ffmpeg -i '{}' -progress '{}' -map 0:V -map 0:a? -map 0:s? -c:v libx264 -preset veryfast -crf 34 -pix_fmt yuv420p -s 640x360 -movflags +faststart -c:a aac -b:a 48k -c:s copy '{}' -y
