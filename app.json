{
  "name": "Anime Finder / Leecher Bot",
  "description": "Search torrents, leech, encode and post to Telegram.",
  "keywords": ["telegram", "bot", "torrent", "leech", "anime"],
  "repository": "https://github.com/Monstar0X/Anime",
  "env": {
    "API_ID": { "description": "From https://my.telegram.org", "value": "" },
    "API_HASH": { "description": "From https://my.telegram.org", "value": "" },
    "BOT_TOKEN": { "description": "From @BotFather", "value": "" },
    "DB_URI": { "description": "MongoDB connection string (free Atlas M0)", "value": "" },
    "DB_NAME": { "description": "Database name", "value": "Cluster0" },
    "LOG_CHANNEL": { "description": "Channel id that receives log messages", "value": "" },
    "CHANNEL_ID": { "description": "Channel the bot verifies at startup", "value": "" },
    "FILE_STORE": { "description": "Channel where uploaded files are stored", "value": "" },
    "POST_CHANNEL": { "description": "Channel where finished posts are published", "value": "" },
    "ADMINS": { "description": "Space separated admin user ids", "value": "" },
    "BRAND_UNAME": { "description": "Brand username shown in captions", "value": "@Nova_Networks" },
    "TORRENT_SITES": { "description": "Comma separated providers", "value": "nyaa,subsplease,apibay,eztv,yts" },
    "TMDB_API_KEY": { "description": "Optional TMDB key", "value": "", "required": false },
    "METADATA_MODE": { "description": "auto | custom | off", "value": "auto", "required": false },
    "AUTO_UPDATE": { "description": "Leave false", "value": "false", "required": false }
  },
  "formation": {
    "worker": { "quantity": 1, "size": "standard-1x" }
  }
}
